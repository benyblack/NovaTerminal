---
// Release asset names follow the workflow in `.github/workflows/release.yml`:
// `NovaTerminal-{rid}-{tag}.zip` (e.g. `NovaTerminal-linux-x64-v0.3.0.zip`).
// The Windows winget package id lives in
// `packaging/winget/0.3.0/benyblack.NovaTerminal.yaml`.
const releases = [
  {
    platform: 'Windows',
    arch: 'x64',
    asset: 'NovaTerminal-win-x64-<tag>.zip',
    cmd: 'winget install benyblack.NovaTerminal',
  },
  {
    platform: 'Linux',
    arch: 'x64',
    asset: 'NovaTerminal-linux-x64-<tag>.zip',
    cmd:
      'unzip NovaTerminal-linux-x64-<tag>.zip\n' +
      'chmod +x NovaTerminal && ./NovaTerminal',
  },
  {
    platform: 'macOS',
    arch: 'arm64',
    asset: 'NovaTerminal-osx-arm64-<tag>.zip',
    cmd:
      'unzip NovaTerminal-osx-arm64-<tag>.zip\n' +
      'open NovaTerminal.app',
  },
];

const buildSteps = [
  {
    title: 'Prerequisites',
    body: '.NET 10 SDK and a stable Rust toolchain. On macOS, install Xcode Command Line Tools. On Windows, MSVC build tools.',
    code: [
      'dotnet --version   # expect 10.x',
      'rustc --version   # expect stable',
      'cargo --version',
    ],
  },
  {
    title: 'Build',
    body: 'dotnet restore triggers a cargo build for the native PTY and SSH libraries automatically.',
    code: [
      'dotnet restore',
      'dotnet build -c Release',
    ],
  },
  {
    title: 'Test',
    body: 'Run the same filter as the blocking CI unit lane (fast, deterministic).',
    code: [
      'dotnet test -c Release --no-build \\',
      '  --filter "Category!=Replay&Category!=RenderMetrics&Category!=PtySmoke&Category!=Stress&Category!=GoldenSharedPng"',
    ],
  },
];
---

<section
  id="install"
  class="section border-b border-ink-900/60"
  aria-labelledby="install-title"
>
  <div class="container-prose">
    <div class="max-w-3xl">
      <span class="eyebrow">Install</span>
      <h2
        id="install-title"
        class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        Pick a build, get to work.
      </h2>
      <p class="lede mt-4 max-w-2xl">
        GitHub release assets ship as Native AOT bundles for
        <code class="rounded bg-ink-800/60 px-1.5 py-0.5 text-nova-200">win-x64</code>,
        <code class="rounded bg-ink-800/60 px-1.5 py-0.5 text-nova-200">linux-x64</code>, and
        <code class="rounded bg-ink-800/60 px-1.5 py-0.5 text-nova-200">osx-arm64</code>. Every release runs the gating unit-test lane on all three OSes before any bundle is published. Replace <code class="rounded bg-ink-800/60 px-1.5 py-0.5 text-nova-200">&lt;tag&gt;</code> with the version you downloaded.
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-3">
      {
        releases.map((rel) => (
          <article class="card h-full">
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="text-base font-semibold text-white">
                {rel.platform}
              </h3>
              <span class="font-mono text-xs text-ink-400">{rel.arch}</span>
            </div>
            <p class="mt-2 text-sm text-ink-300">
              Native AOT, self-contained. Download from
              {' '}
              <a
                href="https://github.com/benyblack/NovaTerminal/releases/latest"
                rel="noopener"
                class="text-nova-300"
              >
                the latest release
              </a>
              .
            </p>
            <p class="mt-2 font-mono text-[11px] text-ink-400">
              {rel.asset}
            </p>
            <pre class="code-block mt-3 text-xs leading-relaxed"><code>{rel.cmd}</code></pre>
          </article>
        ))
      }
    </div>

    <div class="mt-12 rounded-2xl border border-ink-800 bg-ink-900/40 p-6 sm:p-8">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h3 class="text-xl font-semibold text-white sm:text-2xl">
          Build from source
        </h3>
        <span class="font-mono text-xs text-ink-400">net10.0 · Rust 2024</span>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-3">
        {
          buildSteps.map((step, i) => (
            <div>
              <p class="flex items-center gap-2 text-sm font-semibold text-white">
                <span
                  class="grid h-5 w-5 place-items-center rounded-full bg-nova-500/15 font-mono text-[10px] text-nova-300"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                {step.title}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-ink-300">
                {step.body}
              </p>
              <pre class="code-block mt-3 text-xs leading-relaxed"><code>{step.code.join('\n')}</code></pre>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
